# Expo public env (safe to expose in the client bundle).
# These are the default Supabase local-dev values printed by `supabase status`.
# The anon key below is the well-known deterministic local key (NOT a secret).
# Copy this file to .env for local development: cp .env.example .env
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Server-side only: used by the parse-feeding Edge Function for voice/AI parsing.
# Export this in the shell BEFORE running `supabase start` so the local Edge
# runtime can read it (see supabase/config.toml [edge_runtime.secrets]).
# Without it, parse-feeding returns 501 and manual entry still works.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
